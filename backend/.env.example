# asset-model-studio-backend — example configuration
# Copy this file to .env for local development. .env is git-ignored and MUST
# NOT be committed. Every value below is optional; the defaults are shown.

# TCP address the HTTP server listens on.
APP_ADDR=:8080

# Persistent data directory (SQLite DB, generated secret.key, simulator
# tenants). The CREATE preview runtime sets this to its persistent volume.
# APPLICATION_DATA_DIR=./data

# SQLite file path; defaults to $APPLICATION_DATA_DIR/app.db.
# APP_DB_PATH=./data/app.db

# Minimum log level: debug | info | warn | error
APP_LOG_LEVEL=info

# dev = pino-pretty (needs devDependencies); staging/prod = JSON logs.
APP_ENV=dev

# AES-256-GCM key for connection configs: base64 of exactly 32 bytes.
# Generate one with:  openssl rand -base64 32
# When unset, a key is generated once into $APPLICATION_DATA_DIR/secret.key
# (mode 0600). Losing the key makes stored connections unreadable.
# APP_ENCRYPTION_KEY=

# Comma-separated host suffixes allowed for apiBaseUrl and tokenUrl (SSRF guard).
# APP_ALLOWED_HOST_SUFFIXES=.mindsphere.io,.siemens.app,.siemens.com,.mindsphere-in.cn

# Maximum request body size in bytes (413 beyond).
# APP_BODY_LIMIT_BYTES=10485760

# Per-attempt timeout towards Insights Hub (ms).
# APP_UPSTREAM_TIMEOUT_MS=30000

# Maximum concurrent upstream requests per connection.
# APP_UPSTREAM_CONCURRENCY=8

# Per-user incoming rate limit (token bucket).
# APP_RATE_LIMIT_PER_SEC=50
# APP_RATE_LIMIT_BURST=100

# Artificial latency added to every simulator response (ms, 0 = off).
# APP_SIMULATOR_LATENCY_MS=0

# Serve the built frontend (apps/web/dist) from this server for local installs
# without a reverse proxy, e.g. on Windows (see WINDOWS.md). Unset = API only.
# APP_STATIC_DIR=../apps/web/dist
